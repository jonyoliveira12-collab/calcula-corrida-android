<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A0A0A">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JHONDRIVER"
            android:textColor="#D4AF37"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entre ou crie sua conta"
            android:textColor="#BDBDBD"
            android:textSize="15sp"
            android:layout_marginBottom="28dp"/>
        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="15dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:backgroundTint="#D4AF37"/>
        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha (mínimo 8 caracteres)"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="15dp"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:backgroundTint="#D4AF37"/>
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="ENTRAR"
            android:textStyle="bold"
            android:textColor="#101010"
            android:backgroundTint="#D4AF37"
            android:layout_marginTop="26dp"/>
        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="CRIAR CONTA"
            android:textStyle="bold"
            android:textColor="#D4AF37"
            android:backgroundTint="#292929"
            android:layout_marginTop="10dp"/>
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:visibility="gone"
            android:layout_marginTop="18dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sua senha é protegida pelo serviço de autenticação. Não compartilhe seus dados."
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
