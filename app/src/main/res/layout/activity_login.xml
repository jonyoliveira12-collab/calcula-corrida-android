<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#090A0B">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JD"
            android:textColor="#0B0B0B"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#D6B36A"
            android:padding="16dp"
            android:layout_marginBottom="18dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JHONDRIVER"
            android:textColor="#F4F0E7"
            android:textSize="28sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTELIGÊNCIA PARA CADA CORRIDA"
            android:textColor="#B9A477"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="30dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#17191B">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bem-vindo de volta"
                android:textColor="#F4F0E7"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entre para acompanhar sua jornada."
                android:textColor="#9B9A96"
                android:textSize="13sp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="18dp"/>

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Seu e-mail"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888984"
                android:backgroundTint="#B99A5B"/>
            <CheckBox
                android:id="@+id/rememberEmailCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lembrar meu e-mail neste aparelho"
                android:textColor="#C7B991"
                android:buttonTint="#D6B36A"
                android:checked="true"
                android:layout_marginTop="5dp"/>
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Sua senha"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888984"
                android:backgroundTint="#B99A5B"/>
            <TextView
                android:id="@+id/forgotPasswordText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esqueci minha senha"
                android:textColor="#D6B36A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="end"
                android:paddingTop="13dp"
                android:paddingBottom="5dp"
                android:clickable="true"
                android:focusable="true"/>
            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="ENTRAR"
                android:textStyle="bold"
                android:textColor="#101010"
                android:backgroundTint="#D6B36A"
                android:layout_marginTop="16dp"/>
            <Button
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="CRIAR CONTA"
                android:textStyle="bold"
                android:textColor="#D6B36A"
                android:backgroundTint="#292A2A"
                android:layout_marginTop="10dp"/>
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sua conta protegida. Seus dados de acesso não devem ser compartilhados."
            android:textColor="#777873"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="22dp"/>
    </LinearLayout>
</ScrollView>
